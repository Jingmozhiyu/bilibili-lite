# Docker Compose infrastructure. Replace every credential before an Internet deployment.
POSTGRES_DB=bilibili_lite
POSTGRES_USER=bilibili
POSTGRES_PASSWORD=bilibili
MEILI_ENV=development
MEILI_MASTER_KEY=bilibili-lite-local-meilisearch-master-key
REDIS_PASSWORD=bilibili-local-redis-password

# Public HTTPS entrypoint and the one browser origin allowed by CORS.
BILI_PUBLIC_HOST=localhost
BILI_UPLOAD_HOST=upload.localhost
BILI_FRONTEND_ORIGIN=http://127.0.0.1:5173

# Host bindings stay on loopback so PostgreSQL, Redis, Meilisearch, and gRPC are not public.
BILI_BIND_HOST=127.0.0.1
BILI_HTTP_PORT=8000
BILI_GRPC_PORT=9000
BILI_POSTGRES_PORT=5432
BILI_MEILI_PORT=7700
BILI_REDIS_PORT=6379

# Host media path used by the Docker bind mount. Use an absolute path on a VM.
BILI_MEDIA_HOST_DIR=./data/media
BILI_RUNTIME_UID=1000
BILI_RUNTIME_GID=1000

# Application configuration. These values also support a direct local Go process.
BILI_SERVER_HTTP_NETWORK=tcp
BILI_SERVER_HTTP_ADDR=0.0.0.0:8000
BILI_SERVER_HTTP_TIMEOUT=1800s
BILI_SERVER_GRPC_NETWORK=tcp
BILI_SERVER_GRPC_ADDR=0.0.0.0:9000
BILI_SERVER_GRPC_TIMEOUT=1s
BILI_DATABASE_DRIVER=postgres
BILI_DATABASE_SOURCE="host=127.0.0.1 user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} dbname=${POSTGRES_DB} port=5432 sslmode=disable TimeZone=Asia/Shanghai"
BILI_MEDIA_STORAGE_DIR=storage
BILI_MEDIA_UPLOAD_IDLE_TIMEOUT=30s
BILI_MEDIA_TRANSCODE_TIMEOUT=1200s
BILI_MEDIA_MAX_UPLOAD_BYTES=2147483648
BILI_MEDIA_MAX_COVER_BYTES=10485760
BILI_MEDIA_MAX_USER_STORAGE_BYTES=10737418240
BILI_MEDIA_TRANSCODE_WORKERS=1
BILI_MEDIA_TRANSCODE_POLL_INTERVAL=1s
BILI_SEARCH_ADDRESS=http://127.0.0.1:7700
BILI_SEARCH_API_KEY=${MEILI_MASTER_KEY}
BILI_SEARCH_VIDEO_INDEX=videos
BILI_SEARCH_RETRY_INTERVAL=5s
BILI_REDIS_ADDRESS=127.0.0.1:6379
BILI_REDIS_PASSWORD=${REDIS_PASSWORD}
BILI_REDIS_DATABASE=0
BILI_REDIS_VIDEO_RANKING_KEY=bilibili-lite:videos:hot
BILI_REDIS_USER_RATE_LIMIT_KEY_PREFIX=bilibili-lite:user-rate
BILI_SEED_ENABLED=true
BILI_SEED_PASSWORD=demo123456
BILI_AUTH_ISSUER=bilibili-lite
BILI_AUTH_SECRET=bilibili-lite-local-development-secret-change-me
BILI_AUTH_ACCESS_TTL=7200s
BILI_AUTH_REFRESH_TTL=2592000s
